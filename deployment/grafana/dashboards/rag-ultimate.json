{
  "title": "RAG Ultimate",
  "uid": "rag-ultimate",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Questions / min by outcome",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": ""
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (kind) (rate(rag_queries_total[5m])) * 60",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Answer latency p50 / p95",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(rag_query_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rag_query_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Stage latency p95",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(rag_stage_seconds_bucket[5m])))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "LLM calls by outcome",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": ""
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (provider, outcome) (rate(rag_llm_calls_total[5m])) * 60",
          "legendFormat": "{{provider}} {{outcome}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tokens / hour by model",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": ""
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (model) (increase(rag_llm_tokens_total[1h]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cost (USD) / day by model",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (model) (increase(rag_llm_cost_usd_total[1d]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Guardrail events / hour",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": ""
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (event) (increase(rag_guardrail_events_total[1h]))",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Ingestion jobs by status",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": ""
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (status) (increase(rag_ingestion_jobs_total[1h]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "HTTP 5xx rate",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": ""
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(rag_http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "5xx/s"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Unhandled errors",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": ""
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (component) (increase(rag_errors_total[1h]))",
          "legendFormat": "{{component}}"
        }
      ]
    }
  ]
}
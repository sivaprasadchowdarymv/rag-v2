# Streamlit Community Cloud → your app → ⋮ → Settings → Secrets. Paste, fill in, Save. (TOML: KEY = "value")
# Easiest: fill in .env locally and run `python launch.py secrets` — it writes this file for you.
# Never commit real values (.streamlit/secrets.toml is in .gitignore).

# --- AI models: Groq for text (+ backup keys), free OpenRouter models for images (+ backup keys) ---
GROQ_API_KEY = "gsk_..."
# GROQ_API_KEY_2 = "gsk_..."
# GROQ_API_KEY_3 = "gsk_..."
OPENROUTER_API_KEY = "sk-or-..."
# OPENROUTER_API_KEY_2 = "sk-or-..."
MODEL_DISCOVERY = "off"
MODEL_PROFILE = "free"
LLM_MODE = "hybrid"            # Community Cloud has no Ollama
MASTER_MODELS = "groq:openai/gpt-oss-120b,groq:llama-3.3-70b-versatile,groq:openai/gpt-oss-20b,groq:llama-3.1-8b-instant,openrouter:google/gemma-4-31b-it:free"
FAST_MODELS = "groq:openai/gpt-oss-20b,groq:llama-3.1-8b-instant,groq:llama-3.3-70b-versatile,groq:openai/gpt-oss-120b"
VERIFIER_MODELS = "groq:llama-3.3-70b-versatile,groq:openai/gpt-oss-20b,groq:llama-3.1-8b-instant"
VISION_MODELS = "openrouter:google/gemma-4-31b-it:free,openrouter:nvidia/nemotron-3.5-super-vl:free,openrouter:google/gemma-4-26b-a4b-it:free,openrouter:nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,openrouter:dots-studio/dots-3-note-preview:free,openrouter:openrouter/free"
EMBED_BACKEND = "local"
RERANK_BACKEND = "local"
DAILY_BUDGET_USD = "0.01"
# Confidential / personal-data documents are answered ONLY by local models. There is no local model on
# Community Cloud, so such questions are refused unless you consciously allow a cloud provider:
# ALLOW_SENSITIVE_CLOUD = "true"
# CLOUD_PROVIDERS_ALLOWED = "groq"

# --- Accounts (the app is on the internet: keep this on) ---
AUTH_MODE = "users"
ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = "ChangeMe-Strong-2026"

# --- Persistence (Community Cloud wipes the local disk on every restart) ---
# Database: free PostgreSQL, e.g. neon.tech -> copy the connection string
DATABASE_URL = "postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
# Search indexes + figures: private Hugging Face dataset (created automatically)
HF_TOKEN = "hf_..."
HF_DATASET_REPO = "your-hf-username/rag-ultimate-data"

# --- Upgraded features (defaults shown) ---
ANSWER_CACHE_ENABLED = "true"
ANSWER_CACHE_TTL = "3600"
RATE_LIMIT_PER_MIN = "8"
LOG_FORMAT = "text"

# =============================================================================
# RAG∞ Ultimate 2.2 — COMPLETE .env : Groq + OpenRouter + AnyRouter (all free routes)
# =============================================================================
# HOW TO USE
#   1. Put this file in the project folder (next to app.py) and name it exactly:  .env
#   2. Paste your keys after GROQ_API_KEY=, OPENROUTER_API_KEY= and ANYROUTER_API_KEY= below
#      (no spaces, no quotes). Leave a key empty to skip that provider — the chains adapt automatically.
#   3. Restart the app (Ctrl+C, then: streamlit run app.py). Check Administration → 🔀 Model routing.
#
# RESULTING CHAINS (models are discovered automatically and must be verified free; nothing is hard-coded)
#   TEXT   : Groq primary → Groq fallback 1 → 2 → 3 → AnyRouter free text 1 → 2 → OpenRouter free text 1 → 2
#   VISION : OpenRouter free vision 1 → 2 → 3 → AnyRouter free vision 1 → 2 → 3
#   Text and vision chains are independent: images are never sent to a text model.
#   Paid models are never used (MODEL_FREE_ONLY=true, MODEL_ALLOW_PAID_FALLBACK=false).
#
# NEVER share this file or commit it to GitHub once it contains your keys.

# ---- Keys --------------------------------------------------------------------
# TEXT answers (required): free key, no credit card -> console.groq.com/keys
GROQ_API_KEY=
# IMAGES (+ last text fallbacks): free key -> openrouter.ai/settings/keys . Only ':free' models with zero
# pricing are used. Free models have rate/daily limits that depend on your OpenRouter account.
OPENROUTER_API_KEY=
# Optional BACKUP keys (tried in order when a key is rejected, out of credit or rate-limited):
#   GROQ_API_KEY_2= … GROQ_API_KEY_9=   and   OPENROUTER_API_KEY_2= … OPENROUTER_API_KEY_9=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
# Free text + vision fallbacks: key -> anyrouter.dev . Its free models need the Go plan
# (per AnyRouter's docs: $2/month, or free when you donate one working key). Without it, leave empty.
ANYROUTER_API_KEY=

# free    | Groq for text, Gemma 4 ":free" for images -> $0
# quality | Groq for text, Qwen 3.8 (paid, cents) first for images
MODEL_PROFILE=free

# ---- Override model chains ("provider:model", comma separated, tried in order) ----
# e.g. MASTER_MODELS=groq:openai/gpt-oss-120b,groq:llama-3.3-70b-versatile
#      VISION_MODELS=openrouter:qwen/qwen3.8-flash,openrouter:google/gemma-4-31b-it:free
# 2.2 (discovery mode): placeholders expand to automatically discovered, verified-free models, in this order:
#      @groq (4 Groq models) · @anyrouter_text (2) · @anyrouter_vision (3) · @openrouter_text (2) · @openrouter_vision (3)
# e.g. MASTER_MODELS=@groq,@anyrouter_text,@openrouter_text
#      VISION_MODELS=@openrouter_vision,@anyrouter_vision
MASTER_MODELS=@groq,@anyrouter_text,@openrouter_text
FAST_MODELS=@groq,@anyrouter_text,@openrouter_text
VERIFIER_MODELS=@groq,@anyrouter_text,@openrouter_text
VISION_MODELS=@openrouter_vision,@anyrouter_vision
# Manual alternative (fixed ids instead of discovery — ids can be retired by the provider without notice):
# MASTER_MODELS=groq:openai/gpt-oss-120b,groq:llama-3.3-70b-versatile,groq:openai/gpt-oss-20b,groq:llama-3.1-8b-instant
# VISION_MODELS=openrouter:google/gemma-4-31b-it:free,openrouter:google/gemma-4-26b-a4b-it:free
REASONING_EFFORT=low          # none | low | medium | high  (hidden reasoning of gpt-oss; never shown)
DATA_COLLECTION=allow         # OpenRouter: deny = only upstreams that don't store prompts (free endpoints may vanish)
APP_URL=https://github.com/your-name/rag-ultimate
APP_TITLE=RAG Ultimate

# ---- Images: when Qwen / Gemma are used -----------------------------------------
IMAGE_ANSWERS=true            # figure questions: attach the figure images (else captions only, via Groq)
MAX_ANSWER_IMAGES=2           # images per figure question
IMAGE_MAX_PX=1024             # images are downscaled first (fewer image tokens)
OCR_SCANNED=true              # read image-only (scanned) pages while indexing
MAX_OCR_PAGES=40
VISION_INDEX=false            # describe EVERY figure while indexing (many calls; off = only when asked)
MAX_VISION_FIGURES=40
VISION_WORKERS=4

# ---- Retrieval (local = 0 tokens) -------------------------------------------------
EMBED_BACKEND=local           # local | openrouter (Qwen3-Embedding) | auto
RERANK=true
RERANK_BACKEND=local          # local | openrouter (Qwen3-Reranker) | auto
EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5-Q
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
EMBED_MODEL_REMOTE=qwen/qwen3-embedding-8b
RERANK_MODEL_REMOTE=qwen/qwen3-reranker-8b
EMBED_DIMS=1024

# ---- Answering (token budget) ----------------------------------------------------
AGENT_MODE=agent              # agent (tools only for calculations/comparisons) | quick (always one call)
AGENT_MAX_STEPS=3
VERIFY_WITH_LLM=false         # extra LLM check (Groq Llama 70B); deterministic checks always run for free
MAX_REGENERATIONS=1
MEMORY_TURNS=2
MAX_OUTPUT_TOKENS=1500
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=90

# ---- Retrieval, chunking, uploads -------------------------------------------
TOP_K=3
CHUNK_SIZE=400
CHUNK_OVERLAP=60
MAX_CONTEXT_CHUNKS=6
MAX_CONTEXT_CHARS=5000        # ~1,250 tokens of evidence per answer
MAX_UPLOAD_MB=50
MAX_PAGES=500

# ---- Persistent storage (recommended on Streamlit Cloud) -------------------
# Private Hugging Face dataset that keeps chats, feedback, preferences and
# document indexes across restarts. The dataset is created (private) automatically.
HF_TOKEN=
# e.g. your-hf-username/rag-ultimate-data  (or file:///path for a local disk)
HF_DATASET_REPO=
SYNC_INTERVAL=45

# ---- Access and production guards ----------------------------------------------
# if set, the whole app asks for this password
APP_PASSWORD=
RATE_LIMIT_PER_MIN=8        # questions per browser session per minute (0 = off)
GLOBAL_RATE_LIMIT_PER_MIN=25 # Groq free tier: ~30 requests/min
DAILY_BUDGET_USD=0          # 0 = off; pauses AI answers once today's OpenRouter spend reaches this
# ---- Verified-answer cache (2.1) — in-memory, per process, no extra service --------
ANSWER_CACHE_ENABLED=true   # master switch
ANSWER_CACHE_SIZE=256       # max cached answers (LRU eviction); 0 = off
ANSWER_CACHE_TTL=3600       # seconds a cached answer stays valid; 0 = off
ANSWER_CACHE_SIMILARITY=0.90 # 0 = exact (normalised) wording only; 0.9 = near-identical wording also matches
ANSWER_CACHE_SCOPE=user     # user = per account/workspace; tenant = shared by users of a tenant with the SAME roles
HEALTH_WEIGHTS=0.30,0.20,0.20,0.20,0.10
LOG_LEVEL=INFO

# ---- Cross-modal concept linking -------------------------------------------
CONCEPT_LINKING=true
CONCEPT_EXPAND_MAX=4
CONCEPT_MIN_CONF=0.6
CONCEPT_LLM_RESOLVE=false

# =============================================================================
# RAG Ultimate 2.0 platform settings (defaults keep 1.x behaviour)
# =============================================================================
# ---- Free-model fallback chains (2.2) -----------------------------------------
# TEXT:   Groq primary + 3 Groq fallbacks (discovered from GROQ_API_KEY's model list)
#         → 2 AnyRouter free text models.  VISION: 3 AnyRouter free vision models (independent chain).
# Model ids are discovered automatically; nothing is hard-coded. A model is used only when AnyRouter's catalogue
# shows it routable for your key, free (not BYOK-only, not credit-priced) and priced at exactly zero.
# AnyRouter free models need an eligible account plan — creating a key alone does not enable free usage.
ANYROUTER_BASE_URL=https://anyrouter.dev/api/v1
MODEL_DISCOVERY=on              # on = use the discovered chains above (also works without an AnyRouter key)
MODEL_CATALOG_REFRESH_MINUTES=30  # catalogue cache; never refreshed per question
MODEL_REQUEST_TIMEOUT=45        # seconds per model call
MODEL_MAX_RETRIES=2             # per model, on 429 / 5xx / timeout / connection errors (exponential backoff)
MODEL_FREE_ONLY=true            # automatic chains contain verified-free models only
MODEL_ALLOW_PAID_FALLBACK=false # paid providers need BOTH this=true AND MODEL_FREE_ONLY=false
MODEL_FAILURE_EXCLUDE=5         # consecutive failures before a model is replaced until the next refresh
MODEL_MAX_IMAGE_MB=8            # max size per image sent to a vision model

# ---- Multi-LLM / routing ------------------------------------------------------
LLM_MODE=hybrid               # local (Ollama only) | cloud (no Ollama) | hybrid
ROUTING_STRATEGY=priority     # priority | cost | latency | auto (cheap/fast models for simple questions)
# force one "provider:model" (still policy-checked), e.g. ollama:llama3.1:8b
MANUAL_MODEL=
# e.g. http://localhost:11434 (docker: http://ollama:11434). Empty = Ollama off
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b
OLLAMA_FAST_MODEL=
# e.g. llava:7b
OLLAMA_VISION_MODEL=
OLLAMA_EMBED_MODEL=nomic-embed-text   # used when EMBED_BACKEND=ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible server (vLLM, LM Studio, gateways)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# e.g. us-east-1 (uses the standard AWS credential chain; needs boto3)
BEDROCK_REGION=
BEDROCK_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0
ALLOW_SENSITIVE_CLOUD=false   # confidential / PII documents go ONLY to local models unless true
# comma list allowed for sensitive data when the above is true, e.g. anthropic
CLOUD_PROVIDERS_ALLOWED=
LLM_MAX_RETRIES=2
CIRCUIT_FAILURES=3
CIRCUIT_COOLDOWN_S=60
# optional price overrides {"openai:gpt-4o-mini": [0.15, 0.6, 128000]}
LLM_PRICES_JSON=

# ---- Ingestion ------------------------------------------------------------------
CHUNK_STRATEGY=recursive      # recursive | fixed | semantic | structure
OCR_LOCAL=true                # tesseract OCR for images and scanned pages (offline)
INGEST_WORKERS=2
INGEST_RETRIES=2
KEEP_ORIGINALS=true
MODEL_RETRY_S=600             # after a local model download fails, retry no sooner than this
MODEL_DOWNLOAD=true           # false = never download local models (air-gapped; pre-seed data/models)

# ---- Retrieval --------------------------------------------------------------------
QUERY_REWRITE=true
MULTI_QUERY=2                 # query variants fused by RRF (1 = off)
LLM_QUERY_REWRITE=false
PARENT_CHILD=true
CONTEXT_COMPRESSION=false

# ---- Agents ------------------------------------------------------------------------
AGENT_TIMEOUT_S=120
SUMMARIZE_MAX_SECTIONS=8

# ---- Security ------------------------------------------------------------------------
AUTH_MODE=none                # none (single local user) | password (APP_PASSWORD) | users (accounts + RBAC)
# first admin, created at start-up when no user exists (AUTH_MODE=users)
ADMIN_USERNAME=
# >= 10 characters, letters and digits
ADMIN_PASSWORD=
INJECTION_POLICY=block        # block | warn
HARMFUL_POLICY=block          # block | warn
PII_INPUT_POLICY=redact       # block | redact | mask | allow
PII_OUTPUT_POLICY=authorized  # authorized (admins / "pii" role see values) | mask | redact | block | allow
# comma list; empty = no domain boundary
ALLOWED_TOPICS=
RESTRICTED_TOPICS=
ABSTAIN_UNGROUNDED=true

# ---- Database / storage -----------------------------------------------------------
# empty = SQLite in DATA_DIR; e.g. postgresql://rag:pass@localhost:5432/rag
DATABASE_URL=
STORAGE_BACKEND=local         # local | s3 (MinIO / S3; needs boto3)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Observability / API -------------------------------------------------------------
LOG_FORMAT=text               # text | json
METRICS_ENABLED=true          # GET /metrics on the API (Prometheus)
# e.g. http://otel-collector:4318 (needs requirements-optional.txt)
OTEL_EXPORTER_OTLP_ENDPOINT=
API_CORS_ORIGINS=

# ---- docker compose (PROFILE B / C) --------------------------------------------------
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# public host name for Caddy HTTPS
DOMAIN=

# ---- Advanced (rarely changed) ---------------------------------------------------------
# default ./data
DATA_DIR=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
MAX_CHARS_PER_CHUNK=900
MIN_FIGURE_PX=48
OBSERVATION_CHARS=1500
SUPPORT_THRESHOLD=0.0
SUPPORT_THRESHOLD_REMOTE=0.25
ENABLE_FEEDBACK=false
